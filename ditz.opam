# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Distributed issue tracker"
description:
  "A simple, light-weight distributed issue tracker designed to work with git"
maintainer: ["Edward Smith"]
authors: ["Edward Smith"]
license: "GPL-3.0-or-later"
homepage: "https://github.com/tedks/ditz"
bug-reports: "https://github.com/tedks/ditz/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.0" & >= "3.0"}
  "cmdliner"
  "yaml"
  "ppx_deriving"
  "ppx_deriving_yaml"
  "digestif"
  "fmt"
  "logs"
  "ptime"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/tedks/ditz.git"
